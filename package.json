{
  "name": "jay-snyder-signal",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "SIGNAL — the interactive, gamified portfolio of Jay W. Snyder: AI engineer, business builder, game developer.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "smoke": "node scripts/smoke.mjs",
    "smoke:serve": "http-server dist -p 4173 -a 127.0.0.1 -c-1 --silent"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "gh-pages": "^6.3.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
